// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum UserRole {
  EMPLOYEE
  ADMIN
  IT_TECHNICIAN
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TicketCategory {
  HARDWARE
  SOFTWARE
  NETWORK
  SECURITY
  OTHER
}

enum AssetCategory {
  LAPTOP
  DESKTOP
  MONITOR
  PRINTER
  NETWORK_DEVICE
  PERIPHERAL
  OTHER
}

enum AssetStatus {
  AVAILABLE
  ASSIGNED
  MAINTENANCE
  RETIRED
}

enum AssetCondition {
  NEW
  GOOD
  FAIR
  POOR
  DAMAGED
}

enum AssetHistoryAction {
  ASSIGNED
  UNASSIGNED
}

model User {
  id        Int      @id @default(autoincrement())
  firstName String
  lastName  String
  email     String   @unique
  password  String
  role      UserRole @default(EMPLOYEE)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdTickets         Ticket[]       @relation("TicketCreator")
  assignedTickets        Ticket[]       @relation("TicketAssignee")
  assignedAsset          Asset[]        @relation("AssetAssignee")
  assetHistoryAsEmployee AssetHistory[] @relation("AssetHistoryEmployee")
  assetHistoryPerformed  AssetHistory[] @relation("AssetHistoryPerformedBy")
}

model Ticket {
  id          Int            @id @default(autoincrement())
  title       String
  description String         @db.Text
  status      TicketStatus   @default(OPEN)
  priority    TicketPriority @default(MEDIUM)
  category    TicketCategory @default(OTHER)

  createdById Int
  createdBy   User @relation("TicketCreator", fields: [createdById], references: [id])

  assignedToId Int?
  assignedTo   User? @relation("TicketAssignee", fields: [assignedToId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Asset {
  id           Int            @id @default(autoincrement())
  assetTag     String         @unique
  name         String
  description  String?        @db.Text
  category     AssetCategory
  serialNumber String?        @unique
  brand        String?
  model        String?
  status       AssetStatus    @default(AVAILABLE)
  condition    AssetCondition @default(GOOD)

  assignedToId Int?
  assignedTo   User? @relation("AssetAssignee", fields: [assignedToId], references: [id])

  history AssetHistory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AssetHistory {
  id     Int                @id @default(autoincrement())
  action AssetHistoryAction

  assetId Int
  asset   Asset @relation(fields: [assetId], references: [id])

  employeeId Int
  employee   User @relation("AssetHistoryEmployee", fields: [employeeId], references: [id])

  performedById Int
  performedBy   User @relation("AssetHistoryPerformedBy", fields: [performedById], references: [id])

  createdAt DateTime @default(now())
}
